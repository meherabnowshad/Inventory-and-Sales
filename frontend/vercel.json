      "has": [
        {
          "type": "host",
          "value": "smartmart-web-git-master-nowshad.vercel.app"
        }
      ],
      "destination": "https://inventory-and-sales-xpw9-git-master-nowshad.vercel.app/api/:path*"
    },
    {
      "source": "/api/:path*",

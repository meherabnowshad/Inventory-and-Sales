# Backend API Base URL
# Default '/api' uses Vite dev proxy (vite.config.ts) to forward to http://localhost:5001/api
VITE_API_BASE_URL=/api

# Application Metadata
VITE_APP_NAME="Inventory & Sales Manager"
VITE_APP_VERSION=1.0.0

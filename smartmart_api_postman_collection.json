          ]
        }
      }
    },
    {
      "name": "2. Login as Sadia (Auto-sets Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "var tokenVal = jsonData.accessToken || jsonData.token;",
              "if (tokenVal) {",
              "    pm.collectionVariables.set('token', tokenVal);",
              "    console.log('Saved token successfully');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"sadia\",\n  \"password\": \"Smart@1234\"\n}"
        },
        "url": {
          "raw": "http://localhost:5001/api/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5001",
          "path": [
            "api",

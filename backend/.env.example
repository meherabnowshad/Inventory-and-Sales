# ==============================================================================
# Inventory & Sales Management System - Backend Environment Configuration
# Subtask: IMS-03.1 | Covers: NFR-SEC-03, NFR-OPS-01
# Copy this file to .env before starting the server: cp .env.example .env
# DO NOT commit the actual .env file to version control.
# ==============================================================================

# Server Network Configuration (using port 5001 to prevent conflict with macOS AirPlay receiver on 5000)
PORT=5001
NODE_ENV=development

# Database Connection (PostgreSQL with Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory_sales_db?schema=public"

# Cross-Origin Resource Sharing (CORS)
# Comma-separated allowed origins or single origin for local frontend
CORS_ORIGIN=http://localhost:5173

# Security & Authentication (JWT Secret)
# Generate a strong 256-bit random key in production
JWT_SECRET=super_secret_jwt_dev_key_change_in_production_32chars
JWT_EXPIRES_IN=1d

# Request Rate Limiting / Logging
LOG_LEVEL=dev


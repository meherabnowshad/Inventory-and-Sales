// Prisma schema for SmartMart Inventory & Sales Management System
// Task: IMS-04.1 | Source: docs/database/schema.md (SRS section 5, 14 tables; idempotency_keys added in IMS-02.4)
//
// Rules Prisma cannot express are added by hand in the migration SQL:
// CHECK constraints, lower() unique indexes, partial indexes, generated
// columns, triggers (BR-12 SKU lock, append-only ledger/audit log) and REVOKE.
// See prisma/migrations/20261105000000_init_schema/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- access

model Role {
  id    Int    @id @default(autoincrement()) @db.SmallInt
  name  String @unique @db.VarChar(40)
  users User[]

  @@map("roles")
}

model User {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(120)
  username     String   @db.VarChar(40)
  email        String   @db.VarChar(254)
  passwordHash String   @map("password_hash")
  roleId       Int      @map("role_id") @db.SmallInt
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    BigInt?  @map("created_by")

  // Login throttle (FR-AUTH-05, IMS-02.4 point 4); migration 20261111000000_users_login_throttle
  failedLogins  Int       @default(0) @map("failed_logins")
  firstFailedAt DateTime? @map("first_failed_at") @db.Timestamptz(6)
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(6)

  role    Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  creator User?  @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  created User[] @relation("UserCreatedBy")

  categoriesCreated      Category[]      @relation("CategoryCreatedBy")
  productsCreated        Product[]       @relation("ProductCreatedBy")
  suppliersCreated       Supplier[]      @relation("SupplierCreatedBy")
  customersCreated       Customer[]      @relation("CustomerCreatedBy")
  purchaseOrdersCreated  PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  purchaseOrdersReceived PurchaseOrder[] @relation("PurchaseOrderReceivedBy")
  invoicesCreated        SalesInvoice[]  @relation("InvoiceCreatedBy")
  invoicesConfirmed      SalesInvoice[]  @relation("InvoiceConfirmedBy")
  returnsProcessed       SalesReturn[]   @relation("ReturnProcessedBy")
  stockMovements         StockMovement[]
  auditLogs              AuditLog[]
  idempotencyKeys        IdempotencyKey[]
  refreshTokens          RefreshToken[]

  @@index([roleId], map: "users_role_id_idx")
  @@map("users")
}

// Rotating session refresh tokens & revocation (FR-AUTH-02, FR-AUTH-03, NFR-SEC-05).
// Added by migration 20261113000000_refresh_tokens (IMS-05 / IMS-02.4 point 3).
model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId], map: "refresh_tokens_user_id_idx")
  @@map("refresh_tokens")
}

// ----------------------------------------------------------- master data

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   BigInt   @map("created_by")

  creator  User      @relation("CategoryCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  products Product[]

  @@map("categories")
}

model Product {
  id            BigInt   @id @default(autoincrement())
  sku           String   @db.VarChar(40)
  name          String   @db.VarChar(120)
  categoryId    Int      @map("category_id")
  purchasePrice Decimal  @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice  Decimal  @map("selling_price") @db.Decimal(12, 2)
  minStock      Int      @default(0) @map("min_stock")
  stockQty      Int      @default(0) @map("stock_qty")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     BigInt   @map("created_by")

  category       Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator        User                @relation("ProductCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  poLines        PurchaseOrderLine[]
  invoiceLines   SalesInvoiceLine[]
  stockMovements StockMovement[]

  @@index([categoryId], map: "products_category_idx")
  @@map("products")
}

model Supplier {
  id            BigInt   @id @default(autoincrement())
  name          String   @db.VarChar(120)
  contactPerson String?  @map("contact_person") @db.VarChar(120)
  phone         String   @db.Char(11)
  email         String?  @db.VarChar(254)
  address       String?  @db.VarChar(255)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     BigInt   @map("created_by")

  creator        User            @relation("SupplierCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Customer {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(120)
  phone     String?  @unique @db.Char(11)
  email     String?  @db.VarChar(254)
  address   String?  @db.VarChar(255)
  isWalkIn  Boolean  @default(false) @map("is_walk_in")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy BigInt   @map("created_by")

  creator  User           @relation("CustomerCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  invoices SalesInvoice[]

  @@map("customers")
}

// ------------------------------------------------------------ purchasing

model PurchaseOrder {
  id           BigInt    @id @default(autoincrement())
  poNumber     String    @unique @map("po_number") @db.Char(14)
  supplierId   BigInt    @map("supplier_id")
  status       String    @default("DRAFT") @db.VarChar(10)
  orderDate    DateTime  @map("order_date") @db.Date
  expectedDate DateTime? @map("expected_date") @db.Date
  total        Decimal   @default(0) @db.Decimal(12, 2)
  receivedBy   BigInt?   @map("received_by")
  receivedAt   DateTime? @map("received_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    BigInt    @map("created_by")

  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  receiver User?               @relation("PurchaseOrderReceivedBy", fields: [receivedBy], references: [id], onDelete: Restrict)
  creator  User                @relation("PurchaseOrderCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  lines    PurchaseOrderLine[]

  @@index([supplierId], map: "purchase_orders_supplier_idx")
  @@index([status, orderDate(sort: Desc)], map: "purchase_orders_status_date")
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id        BigInt   @id @default(autoincrement())
  poId      BigInt   @map("po_id")
  productId BigInt   @map("product_id")
  quantity  Int
  unitCost  Decimal  @map("unit_cost") @db.Decimal(12, 2)
  // GENERATED ALWAYS AS (quantity * unit_cost) STORED, created in the migration SQL
  lineTotal Decimal? @default(dbgenerated()) @map("line_total") @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([poId, productId], map: "po_lines_one_per_product")
  @@index([productId], map: "po_lines_product_idx")
  @@map("purchase_order_lines")
}

// ----------------------------------------------------------------- sales

model SalesInvoice {
  id             BigInt    @id @default(autoincrement())
  invoiceNumber  String?   @unique @map("invoice_number") @db.Char(15)
  customerId     BigInt    @map("customer_id")
  status         String    @default("DRAFT") @db.VarChar(10)
  total          Decimal   @default(0) @db.Decimal(12, 2)
  paymentMethod  String?   @map("payment_method") @db.VarChar(15)
  confirmedBy    BigInt?   @map("confirmed_by")
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(6)
  idempotencyKey String?   @unique @map("idempotency_key") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      BigInt    @map("created_by")

  customer  Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  confirmer User?              @relation("InvoiceConfirmedBy", fields: [confirmedBy], references: [id], onDelete: Restrict)
  creator   User               @relation("InvoiceCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  lines     SalesInvoiceLine[]
  returns   SalesReturn[]

  @@index([customerId], map: "sales_invoices_customer_idx")
  @@index([confirmedAt(sort: Desc)], map: "sales_invoices_confirmed_at")
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id        BigInt   @id @default(autoincrement())
  invoiceId BigInt   @map("invoice_id")
  productId BigInt   @map("product_id")
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  // GENERATED ALWAYS AS (quantity * unit_price) STORED, created in the migration SQL
  lineTotal Decimal? @default(dbgenerated()) @map("line_total") @db.Decimal(12, 2)

  invoice     SalesInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnLines SalesReturnLine[]

  @@unique([invoiceId, productId], map: "invoice_lines_one_per_product")
  @@index([productId], map: "invoice_lines_product_idx")
  @@map("sales_invoice_lines")
}

// --------------------------------------------------------------- returns

model SalesReturn {
  id          BigInt   @id @default(autoincrement())
  returnNumber String  @unique @map("return_number") @db.Char(15)
  invoiceId   BigInt   @map("invoice_id")
  reason      String   @db.VarChar(255)
  refundTotal Decimal  @map("refund_total") @db.Decimal(12, 2)
  processedBy BigInt   @map("processed_by")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  invoice   SalesInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  processor User              @relation("ReturnProcessedBy", fields: [processedBy], references: [id], onDelete: Restrict)
  lines     SalesReturnLine[]

  @@index([invoiceId], map: "sales_returns_invoice_idx")
  @@map("sales_returns")
}

model SalesReturnLine {
  id            BigInt  @id @default(autoincrement())
  returnId      BigInt  @map("return_id")
  invoiceLineId BigInt  @map("invoice_line_id")
  quantity      Int
  condition     String  @db.VarChar(10)
  refundAmount  Decimal @map("refund_amount") @db.Decimal(12, 2)

  salesReturn SalesReturn      @relation(fields: [returnId], references: [id], onDelete: Restrict)
  invoiceLine SalesInvoiceLine @relation(fields: [invoiceLineId], references: [id], onDelete: Restrict)

  @@unique([returnId, invoiceLineId], map: "return_lines_one_per_invoice_line")
  @@index([invoiceLineId], map: "return_lines_invoice_line_idx")
  @@map("sales_return_lines")
}

// --------------------------------------------------------------- history

model StockMovement {
  id          BigInt   @id @default(autoincrement())
  productId   BigInt   @map("product_id")
  type        String   @db.VarChar(10)
  quantity    Int
  stockBefore Int      @map("stock_before")
  stockAfter  Int      @map("stock_after")
  refType     String   @map("ref_type") @db.VarChar(20)
  refId       BigInt   @map("ref_id")
  reason      String?  @db.VarChar(10)
  note        String?  @db.VarChar(255)
  userId      BigInt   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt(sort: Desc)], map: "movements_product_time")
  @@index([type, createdAt(sort: Desc)], map: "movements_type_time")
  @@index([userId, createdAt(sort: Desc)], map: "movements_user_time")
  @@map("stock_movements")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  entity     String   @db.VarChar(40)
  entityId   BigInt    @map("entity_id")
  action     String   @db.VarChar(40)
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  userId     BigInt   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entity, entityId, createdAt(sort: Desc)], map: "audit_log_entity_time")
  @@index([userId, createdAt(sort: Desc)], map: "audit_log_user_time")
  @@map("audit_log")
}

// ------------------------------------------------------------ idempotency

// Retry protection for receive, confirm, returns and adjustments (FR-SAL-07, FR-RET-06).
// Added by migration 20261111000100_idempotency_keys (IMS-02.4 point 2).
model IdempotencyKey {
  userId       BigInt   @map("user_id")
  key          String   @db.Uuid
  requestHash  String   @map("request_hash") @db.Char(64)
  responseCode Int?     @map("response_code") @db.SmallInt
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, key])
  @@map("idempotency_keys")
}

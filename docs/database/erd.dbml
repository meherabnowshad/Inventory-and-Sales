Table roles {
  id serial [pk]
  name varchar(40) [not null, unique, note: 'Administrator, Sales Staff, Store Staff']
}

Table users {
  id bigserial [pk]
  name varchar(120) [not null]
  username varchar(40) [not null, unique]
  email varchar(254) [not null, unique]
  password_hash text [not null]
  role_id smallint [not null, ref: > roles.id]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by bigint [ref: > users.id]
  failed_logins integer [not null, default: 0, note: '>= 0, failed logins in the current window']
  first_failed_at timestamptz [note: 'start of the 15-minute window']
  locked_until timestamptz [note: 'login refused until this time']
}

Table categories {
  id serial [pk]
  name varchar(80) [not null, unique, note: 'unique, ignoring case']
  description varchar(255)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by bigint [ref: > users.id]
}

Table products {
  id bigserial [pk]
  sku varchar(40) [not null, unique]
  name varchar(120) [not null]
  category_id integer [not null, ref: > categories.id]
  purchase_price decimal(12,2) [not null, note: '>= 0']
  selling_price decimal(12,2) [not null, note: '>= 0']
  min_stock integer [not null, default: 0]
  stock_qty integer [not null, default: 0, note: '>= 0']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by bigint [ref: > users.id]
}

Table suppliers {
  id bigserial [pk]
  name varchar(120) [not null]
  contact_person varchar(120)
  phone varchar(11) [not null]
  email varchar(254)
  address varchar(255)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by bigint [ref: > users.id]
}

Table customers {
  id bigserial [pk]
  name varchar(120) [not null]
  phone varchar(11) [unique]
  email varchar(254)
  address varchar(255)
  is_active boolean [not null, default: true]
  is_walk_in boolean [not null, default: false, note: 'one walk-in row']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by bigint [ref: > users.id]
}

Table purchase_orders {
  id bigserial [pk]
  po_number varchar(20) [not null, unique]
  supplier_id bigint [not null, ref: > suppliers.id]
  status varchar(20) [not null, note: 'Draft, Ordered, Received, Cancelled']
  order_date date [not null]
  expected_date date
  total decimal(12,2) [not null, default: 0]
  received_by bigint [ref: > users.id]
  received_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by bigint [ref: > users.id]
}

Table purchase_order_lines {
  id bigserial [pk]
  po_id bigint [not null, ref: > purchase_orders.id]
  product_id bigint [not null, ref: > products.id]
  quantity integer [not null, note: '> 0']
  unit_cost decimal(12,2) [not null, note: '>= 0']
  line_total decimal(12,2) [not null]
}

Table sales_invoices {
  id bigserial [pk]
  invoice_number varchar(20) [unique]
  customer_id bigint [not null, ref: > customers.id]
  status varchar(20) [not null, note: 'Draft, Confirmed, Cancelled']
  total decimal(12,2) [not null, default: 0]
  payment_method varchar(20)
  confirmed_by bigint [ref: > users.id]
  confirmed_at timestamptz
  idempotency_key uuid [unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by bigint [ref: > users.id]
}

Table sales_invoice_lines {
  id bigserial [pk]
  invoice_id bigint [not null, ref: > sales_invoices.id]
  product_id bigint [not null, ref: > products.id]
  quantity integer [not null, note: '> 0']
  unit_price decimal(12,2) [not null, note: 'copied at sale']
  line_total decimal(12,2) [not null]
}

Table sales_returns {
  id bigserial [pk]
  return_number varchar(20) [not null, unique]
  invoice_id bigint [not null, ref: > sales_invoices.id]
  reason varchar(255) [not null]
  refund_total decimal(12,2) [not null]
  processed_by bigint [not null, ref: > users.id]
  processed_at timestamptz [not null, default: `now()`]
}

Table sales_return_lines {
  id bigserial [pk]
  return_id bigint [not null, ref: > sales_returns.id]
  invoice_line_id bigint [not null, ref: > sales_invoice_lines.id]
  quantity integer [not null, note: '<= sold - already returned']
  condition varchar(20) [not null, note: 'Resellable, Damaged']
  refund_amount decimal(12,2) [not null]
}

Table stock_movements {
  id bigserial [pk]
  product_id bigint [not null, ref: > products.id]
  type varchar(20) [not null, note: 'Receipt, Sale, Return, Adjustment']
  quantity integer [not null, note: 'signed']
  stock_before integer [not null]
  stock_after integer [not null]
  ref_type varchar(20) [not null]
  ref_id bigint [not null]
  reason varchar(40)
  user_id bigint [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Append-only: no update or delete'
}

Table audit_log {
  id bigserial [pk]
  entity varchar(40) [not null]
  entity_id bigint [not null]
  action varchar(40) [not null]
  before_json jsonb
  after_json jsonb
  user_id bigint [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Append-only'
}

Table idempotency_keys {
  user_id bigint [not null, ref: > users.id]
  key uuid [not null]
  request_hash char(64) [not null]
  response_code smallint
  response_body jsonb
  created_at timestamptz [not null, default: `now()`]
  Note: 'Retry protection for receive, confirm, returns and adjustments'

  indexes {
    (user_id, key) [pk]
  }
}
